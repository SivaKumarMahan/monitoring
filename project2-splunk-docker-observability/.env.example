# Copy to .env (git-ignored) and fill in real values:
#   cp .env.example .env
#
# Admin password: at least 8 characters.
SPLUNK_PASSWORD=change-me-Str0ng-pass
# HEC token: any GUID. Generate one with:  uuidgen   (or: python3 -c 'import uuid; print(uuid.uuid4())')
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000

# Read the Splunk license and General Terms first, then keep these lines.
# https://www.splunk.com/en_us/legal/splunk-general-terms.html
# Without a license file, Splunk Enterprise runs on a 60-day trial (500 MB/day).
SPLUNK_START_ARGS=--accept-license
SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com

# Log generator behaviour. Raise ERROR_RATE (e.g. 0.2) to make the 5xx alert fire.
EVENTS_PER_SECOND=5
ERROR_RATE=0.02
LATENCY_MS=150
